<resources>
    <style name="Theme.Dropi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch screen themes for the Light and System settings (Android 13+ remembers the one
         MainActivity picks; see values-v31). Before Android 12 they look like the dark one. -->
    <style name="Theme.Dropi.Light" parent="Theme.Dropi" />
    <style name="Theme.Dropi.System" parent="Theme.Dropi" />
</resources>
